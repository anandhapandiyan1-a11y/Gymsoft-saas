# GymSoft SaaS - Production Environment Variables
# Copy this file to .env and fill in your values

# Security - REQUIRED: Generate a strong random secret for production
# openssl rand -hex 32
SECRET_KEY=your_super_secret_key_here_change_in_production

# Algorithm for JWT
ALGORITHM=HS256

# Token expiry in minutes (24 hours)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Trial days for new gym owners
TRIAL_DAYS=7

# Database URL
# For SQLite (development): sqlite:///./gymsoft.db
# For PostgreSQL (production): postgresql://user:password@host:port/dbname
DATABASE_URL=sqlite:///./gymsoft.db

# CORS - Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://yourdomain.com

# Environment
ENVIRONMENT=development
DEBUG=True